# Copy this file to infra/config.env and edit the values. setup.sh sources
# config.env automatically if it is present (that file is gitignored).
#
#   cp infra/config.env.example infra/config.env

# Region for every lab resource.
export AWS_REGION=us-east-1

# Short prefix used in resource names (lowercase letters, digits, hyphen).
export PROJECT_NAME=dtlab

# Email that receives SNS fault alerts and the budget alarm.
# You must confirm the SNS subscription from your inbox before alerts arrive.
export NOTIFY_EMAIL=you@university.edu

# Monthly AWS Budgets limit, in USD. Alerts fire at 50% (forecast) and 80/100% (actual).
export MONTHLY_BUDGET_USD=5

# Set to 1 only if you intentionally want Redshift Serverless. It is the
# expensive part of this lab; Athena is the default query engine.
export ENABLE_REDSHIFT=0

# Optional overrides — setup.sh computes these from the values above if unset.
# export ACCOUNT_ID=
# export BUCKET=
# export FIREHOSE_STREAM_NAME=
# export SNS_TOPIC_NAME=
# export LAMBDA_FUNCTION_NAME=
# export GLUE_DATABASE=
# export GLUE_CRAWLER_NAME=
# export S3_PREFIX=telemetry/
# export S3_ERROR_PREFIX=errors/
