{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteLabPrefixOnly",
      "Effect": "Allow",
      "Action": [
        "s3:AbortMultipartUpload",
        "s3:GetBucketLocation",
        "s3:GetObject",
        "s3:ListBucket",
        "s3:ListBucketMultipartUploads",
        "s3:PutObject"
      ],
      "Resource": [
        "arn:aws:s3:::${BUCKET}",
        "arn:aws:s3:::${BUCKET}/${S3_PREFIX}*",
        "arn:aws:s3:::${BUCKET}/${S3_ERROR_PREFIX}*"
      ]
    }
  ]
}
