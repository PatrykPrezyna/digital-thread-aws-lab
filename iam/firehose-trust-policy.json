{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FirehoseAssumeRole",
      "Effect": "Allow",
      "Principal": { "Service": "firehose.amazonaws.com" },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": { "sts:ExternalId": "${ACCOUNT_ID}" }
      }
    }
  ]
}
